{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "browser": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "agent-browser-protocol",
          "--mcp",
          "--verbose",
          "--allow-system-inputs"
        ],
        "disabled": true,
        "environment": {
          "ABP_ARGS": "--no-sandbox"
        },
        "timeout": {
          "startup": 30000
        }
      },
      "dtu-learn": {
        "type": "local",
        "command": [
          "dtu-learn",
          "mcp"
        ]
      }
    }
  }
}
